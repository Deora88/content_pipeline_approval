# Copy this file to content_pipeline/.env and fill in real values.
# A root-level .env also works as a fallback for server.py.
# Never commit the real .env — it's covered by .gitignore.

# Required
OPENROUTER_API_KEY=your-openrouter-key
TAVILY_API_KEY=your-tavily-key

# Optional
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_API_BASE=https://openrouter.ai/api/v1

# Optional — only needed to publish from the web dashboard
LINKEDIN_ACCESS_TOKEN=your-linkedin-token
LINKEDIN_AUTHOR_URN=urn:li:person:xxxx
FACEBOOK_PAGE_ACCESS_TOKEN=your-page-token
FACEBOOK_PAGE_ID=your-page-id
